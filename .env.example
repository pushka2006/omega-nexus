# ══════════════════════════════════════════════════════════════════════════
# OMEGA NEXUS AI OS — Cloud Deployment Environment Configuration
# ══════════════════════════════════════════════════════════════════════════
# ⚠️ DO NOT COMMIT REAL SECRETS TO GITHUB!
# For production, add these variables in the Render & Vercel Web Dashboards.

# ──────────────────────────────────────────────────────────────────────────
# 1. AI PROVIDERS (BACKEND ONLY — Render Environment Variables)
# ──────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
EMERGENT_LLM_KEY=your-emergent-llm-key-here

# ──────────────────────────────────────────────────────────────────────────
# 2. MANAGED DATABASES (MongoDB Atlas & Postgres)
# ──────────────────────────────────────────────────────────────────────────
# MongoDB Atlas Connection String:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexus_os?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/nexus_os
MONGO_URL=mongodb://localhost:27017
DB_NAME=nexus_os

# PostgreSQL URI (Optional / Neon / Supabase):
POSTGRES_URI=postgresql://nexus:nexus_secret@localhost:5432/nexus_business

# ──────────────────────────────────────────────────────────────────────────
# 3. MANAGED REDIS (Upstash / Redis Cloud / Render Redis)
# ──────────────────────────────────────────────────────────────────────────
# rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────────────────────────────────
# 4. OBJECT STORAGE & VECTOR DB (Optional Cloud Storage)
# ──────────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nexus
MINIO_SECRET_KEY=nexus_secret
MINIO_BUCKET=nexus-storage
MINIO_SECURE=false
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ──────────────────────────────────────────────────────────────────────────
# 5. SECURITY & JWT (Generate a secure random string for production)
# ──────────────────────────────────────────────────────────────────────────
JWT_SECRET=generate-a-secure-64-char-random-string-in-production
JWT_EXPIRY_HOURS=24

# ──────────────────────────────────────────────────────────────────────────
# 6. SYSTEM & MASTER AI CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000
MASTER_AI_MODEL=gpt-4o
MASTER_AI_MAX_AGENTS=5000
MASTER_AI_TEMPERATURE=0.7
VMDB_TTL_SECONDS=3600
VMDB_PROMOTION_THRESHOLD=0.75
VMDB_MAX_ENTRIES_PER_AGENT=1000

# ──────────────────────────────────────────────────────────────────────────
# 7. FRONTEND (Vercel Project Settings -> Environment Variables)
# ──────────────────────────────────────────────────────────────────────────
# REACT_APP_BACKEND_URL=https://omega-nexus-backend.onrender.com
