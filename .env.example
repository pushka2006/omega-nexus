# OMEGA NEXUS AI OS – Environment Configuration

# AI Provider
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=

# Database Connections
MONGODB_URI=mongodb://nexus:nexus_secret@localhost:27017/nexus_os?authSource=admin
POSTGRES_URI=postgresql://nexus:nexus_secret@localhost:5432/nexus_business
CHROMA_HOST=localhost
CHROMA_PORT=8001
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nexus
MINIO_SECRET_KEY=nexus_secret
MINIO_BUCKET=nexus-storage
MINIO_SECURE=false

# Security
JWT_SECRET=change-this-in-production
JWT_EXPIRY_HOURS=24

# Virtual Memory Database
VMDB_TTL_SECONDS=3600
VMDB_PROMOTION_THRESHOLD=0.75
VMDB_MAX_ENTRIES_PER_AGENT=1000

# Master AI
MASTER_AI_MODEL=gpt-4o
MASTER_AI_MAX_AGENTS=5000
MASTER_AI_TEMPERATURE=0.7

# System
LOG_LEVEL=INFO
ENVIRONMENT=development
